{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__plugin_bible-study_journal__create_share_link$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/confirm-share.sh\""
          }
        ]
      },
      {
        "matcher": "^mcp__plugin_bible-study_journal__delete_journal$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/confirm-delete-all.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__plugin_bible-study_journal__create_share_link$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/share-receipt.sh\""
          }
        ]
      }
    ]
  }
}
